# Copy to .env and fill with your SMTP credentials

# API listening port
API_PORT=5500

# SMTP server
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

# Mail headers
# CONTACT_FROM defaults to SMTP_USER if not set
# CONTACT_TO is the recipient; defaults to SMTP_USER if not set
CONTACT_FROM=your_smtp_user@example.com
CONTACT_TO=dest@example.com

