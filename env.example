# Configuration SMTP pour l'envoi d'emails de contact
# Copiez ce fichier vers .env et remplissez vos valeurs

# Configuration SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=votre-email@example.com
SMTP_PASS=votre-mot-de-passe-smtp

# Adresses email
CONTACT_TO=votre-email@example.com
CONTACT_FROM=no-reply@votre-domaine.com

# Environnement (optionnel)
APP_ENV=production
