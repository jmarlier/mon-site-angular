RewriteEngine On

# 1) Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Redirect www -> non-www
RewriteCond %{HTTP_HOST} ^www\.jeromemarlier\.com [NC]
RewriteRule ^(.*)$ https://jeromemarlier.com/$1 [L,R=301]

# 3) Variables d'environnement pour l'API PHP de contact (PHPMailer SMTP)
#    Le script public/api/contact-smtp.php lit ces variables via getenv()
#    Remplacez SMTP_* par vos valeurs réelles (o2switch cPanel > Comptes email)
SetEnv SMTP_HOST mail.jeromemarlier.com
SetEnv SMTP_PORT 465
SetEnv SMTP_SECURE ssl
SetEnv SMTP_USER info@jeromemarlier.com
SetEnv SMTP_PASS hO~BlX@=UGZK

# Expéditeur et destinataire par défaut
SetEnv CONTACT_FROM info@jeromemarlier.com
SetEnv CONTACT_TO info@jeromemarlier.com

# 4) SPA fallback vers index.html (laisse passer les fichiers réels comme /api/contact.php)
<IfModule mod_rewrite.c>
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
  # Si vous déployez dans un sous-dossier, ajustez RewriteBase et la cible (ex: /mon-sous-dossier/index.html)
  # RewriteBase /mon-sous-dossier/
  # RewriteRule . /mon-sous-dossier/index.html [L]
</IfModule>

# 5) Mise en cache des assets statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png  "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 6) Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# 7) En-têtes de sécurité basiques
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-XSS-Protection "0"
</IfModule>

# 8) Mode maintenance (toggle simple)
# Activez l'un des triggers suivants pour rediriger vers /maintenance.html :
#  - Définir l'env MAINTENANCE=on (ligne ci-dessous décommentée)
#  - OU créer un fichier vide `maintenance.enable` à la racine du site
# Exemple d'activation via env :
# SetEnv MAINTENANCE on
RewriteCond %{ENV:MAINTENANCE} =on [OR]
RewriteCond %{DOCUMENT_ROOT}/maintenance.enable -f
# Exclusions: page de maintenance elle-même, API, fichiers réels, assets statiques
RewriteCond %{REQUEST_URI} !^/maintenance\.html$
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Ne pas intercepter assets courants (laisser servir directement si demandés)
RewriteCond %{REQUEST_URI} !\.(?:css|js|png|jpe?g|svg|ico|webp|avif)$ [NC]
RewriteRule ^ /maintenance.html [L]
